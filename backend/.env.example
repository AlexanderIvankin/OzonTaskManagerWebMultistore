# --- Приложение ---
PORT=5000
TIMEZONE=Europe/Moscow
TRUST_PROXY=1
NODE_ENV=production

# --- Контексты (для отображения в UI) ---
# ROOT_NAME — название корневого домена (глобального профиля).
# Показывается в сайдбаре, когда мы на главном домене без магазина.
# STORE_NAME задаётся per-store в .env.storeN.
ROOT_NAME=Global

# Корневой домен (глобальный профиль). Здесь живёт страница выбора магазинов,
# сюда ведут ссылки «← Мои магазины» из сабдоменов. Без порта.
# dev:  lvh.me
# prod: your-domain.com
ROOT_DOMAIN=lvh.me

# --- Пути к общим БД ---
USERS_DB_PATH=./users.db
MODELS_DB_PATH=./models.db
NOTIFICATIONS_DB_PATH=./notifications.db
# Путь к БД чата поддержки (отдельная от notifications.db)
CHAT_DB_PATH=./chat.db

# --- JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# --- Создатель ---
GOD_ID=xxx
GOD_EMAIL=xxx@x.com

# --- Ozon (общий ship-идентификатор) ---
SHIP_IDENTIFIER=sku    # offer_id, product_id или sku

# --- S3 (модели — общие) ---
MODELS_S3_ENDPOINT=
MODELS_S3_REGION=
MODELS_S3_BUCKET=
MODELS_S3_ACCESS_KEY=
MODELS_S3_SECRET_KEY=
MODELS_S3_PREFIX=""

# --- Модели (S3-zip first) ---
MODELS_MAX_UPLOAD_MB=1024
MODELS_TOKEN_TTL_MIN=15
MODELS_CACHE_TTL_MIN=60

# --- Бэкапы БД на S3 (отдельный bucket) ---
# Отдельный провайдер/аккаунт:
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=...
BACKUP_S3_SECRET_KEY=...
# Включить выгрузку архива всех БД на S3 после ежедневного бэкапа
BACKUP_S3_ENABLED=true
# Имя bucket для бэкапов (отдельный от моделей!)
BACKUP_S3_BUCKET=ozon-backups
# Префикс ключей внутри bucket (папка)
BACKUP_S3_PREFIX=backups/
# Сколько дней хранить архивы на S3
BACKUP_S3_RETENTION_DAYS=180
# Сколько дней хранить локальные файлы в backups/
BACKUP_LOCAL_RETENTION_DAYS=14

# --- SMTP (общий) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Web Push (ключи глобальные, subject — в .env.storeN) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SUB_RETENTION_DAYS=180
#   DEFAULT_VAPID_SUBJECT — default контакт администратора для push-сервисов (mailto:...).
DEFAULT_VAPID_SUBJECT=mailto:admin@your-domain.com

# Максимум УСТРОЙСТВ на пользователя. Не путать с числом подписок:
# на каждое устройство — своя подписка на каждый origin (главный домен
# + все поддомены магазинов). 5 устройств × 4 origin'а = до 20 подписок.
PUSH_MAX_DEVICES_PER_USER=5

# Аварийный предохранитель: сколько ВСЕГО подписок разрешено на пользователя.
# Должен быть > (устройств × origin'ов), иначе будет резать легитимные
# подписки. Ставь с запасом: 5 устройств × (1 + N магазинов) + резерв.
PUSH_MAX_SUBS_HARD_LIMIT=100

# --- Гости и регистрация ---
GUEST_TTL_HOURS=24
RESEND_CODE_COOLDOWN_SEC=60

# --- Планировщики заказов ---
DELIVER_REMINDER_WARN_DAYS=2
DELIVER_REMINDER_REVOKE_DAYS=3
DELIVER_REMINDER_MAX_ATTEMPTS=10

CANCEL_SYNC_ENABLED=true
CANCEL_SYNC_HOUR=7
CANCEL_SYNC_MINUTE=30
CANCEL_SYNC_WINDOW_HOURS=48
CANCEL_SYNC_MAX_ATTEMPTS=10

ORDER_STATUS_SYNC_ENABLED=true
ORDER_STATUS_SYNC_INTERVAL_MINUTES=60

# --- Акции (глобальное время; per-store enabled — в .env.storeN) ---
PROMOTION_CLEAN_HOUR=3
PROMOTION_CLEAN_MINUTE=0

# Авто-закрытие неактивных диалогов поддержки.
# Закрытый диалог автоматически откроется при новом сообщении пользователя.
CHAT_AUTO_CLOSE_ENABLED=true
CHAT_AUTO_CLOSE_DAYS=30
CHAT_AUTO_CLOSE_HOUR=4
CHAT_AUTO_CLOSE_MINUTE=0
CHAT_AUTO_CLOSE_MAX_ATTEMPTS=3

# --- Отладка ---
DEBUG_ORDERS_MODE=false
OZON_MOCK_MODE=false