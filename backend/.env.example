# --- Приложение ---
PORT=5000
TIMEZONE=Europe/Moscow
TRUST_PROXY=1
NODE_ENV=production

# --- JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# --- Создатель ---
GOD_ID=xxx
GOD_EMAIL=xxx@x.com

# --- Ozon (общий ship-идентификатор) ---
SHIP_IDENTIFIER=sku

# --- S3 (модели — общие) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_MODELS_PREFIX=""

# --- SMTP (общий) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Модели (S3-zip first) ---
MODELS_MAX_UPLOAD_MB=1024
MODELS_TOKEN_TTL_MIN=15
MODELS_CACHE_TTL_MIN=60

# --- Web Push (ключи глобальные, subject — в .env.storeN) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SUB_RETENTION_DAYS=180

# --- Гости и регистрация ---
GUEST_TTL_HOURS=24
RESEND_CODE_COOLDOWN_SEC=60

# --- Планировщики заказов ---
DELIVER_REMINDER_WARN_DAYS=2
DELIVER_REMINDER_REVOKE_DAYS=3
DELIVER_REMINDER_MAX_ATTEMPTS=10

CANCEL_SYNC_ENABLED=true
CANCEL_SYNC_HOUR=7
CANCEL_SYNC_MINUTE=30
CANCEL_SYNC_WINDOW_HOURS=48
CANCEL_SYNC_MAX_ATTEMPTS=10

ORDER_STATUS_SYNC_ENABLED=true
ORDER_STATUS_SYNC_INTERVAL_MINUTES=60

# --- Акции (глобальное время; per-store enabled — в .env.storeN) ---
PROMOTION_CLEAN_HOUR=3
PROMOTION_CLEAN_MINUTE=0

# --- Пути к общим БД ---
USERS_DB_PATH=./users.db
MODELS_DB_PATH=./models.db

# --- Отладка ---
DEBUG_ORDERS_MODE=false
OZON_MOCK_MODE=false