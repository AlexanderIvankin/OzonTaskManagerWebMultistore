STORE_ID=1

DB_PATH=./store-1.db

# Frontend origin для CORS
CLIENT_ORIGIN=https://shop1.your-domain.ru

# Поддомен магазина (без домена верхнего уровня).
# Если не задан — используется STORE_ID.
# Пример: SUBDOMAIN=shop1  ->  shop1.your-domain.ru
SUBDOMAIN=shop1

# Ключи Ozon для данного магазина
OZON_CLIENT_ID=
OZON_API_KEY=

# Фильтрация заказов по суффиксу
FILTER_ORDER_SUFFIX=""

# --- Web Push (оповещения офлайн-пользователям) ---
#   VAPID_SUBJECT     — контакт администратора для push-сервисов (mailto:...).
VAPID_SUBJECT=mailto:admin1@your-domain.ru

# Включение работы с моделями для магазина
DISABLE_MODELS=false

# Включение очистки акций для этого магазина
CLEAN_PROMOTIONS=false