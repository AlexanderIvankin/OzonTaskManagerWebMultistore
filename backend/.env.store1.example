STORE_ID=1

# Человеческое имя магазина (STORE_NAME) — показывается в сайдбаре,
# когда мы на поддомене этого магазина. Для глобального домена
# используйте ROOT_NAME в backend/.env.
STORE_NAME=Store ${STORE_ID}

# Поддомен магазина (без домена верхнего уровня).
# Если не задан — используется STORE_ID.
# Пример: SUBDOMAIN=store1  ->  store1.your-domain.com
SUBDOMAIN=store${STORE_ID}

# Frontend origin для CORS
CLIENT_ORIGIN=https://${SUBDOMAIN}.your-domain.com

# БД магазина
DB_PATH=./store-${STORE_ID}.db

# БД локального кэша возвратов
RETURNS_DB_PATH=./returns-${STORE_ID}.db

# Ключи Ozon для данного магазина
OZON_CLIENT_ID=
OZON_API_KEY=

# Фильтрация заказов по суффиксу
FILTER_ORDER_SUFFIX=""

# --- Web Push (оповещения офлайн-пользователям) ---
#   VAPID_SUBJECT     — контакт администратора для push-сервисов (mailto:...).
VAPID_SUBJECT=mailto:admin@${SUBDOMAIN}.your-domain.com

# Включение работы с моделями для магазина
DISABLE_MODELS=false

# Включение очистки акций для этого магазина
CLEAN_PROMOTIONS=false